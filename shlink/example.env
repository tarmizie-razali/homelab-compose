# Shlink Environment Configuration
# Copy this file to .env and fill in your values

# CORS - Allowed origins for cross-origin requests
# Use * to allow all, or a comma-separated list of origins
CORS_ALLOWED_ORIGINS=*

# Database Configuration
DB_DRIVER=mysql          # mysql, postgres, sqlite, or mssql
DB_HOST=                 # Database host IP or hostname
DB_NAME=shlink           # Database name
DB_PASSWORD=             # Database password
DB_PORT=3306             # Database port (3306 for MySQL, 5432 for PostgreSQL)
DB_USER=shlink           # Database username

# Shlink Domain
DEFAULT_DOMAIN=          # Your public domain e.g. s.yourdomain.com

# GeoLite2 License Key (for geolocation features)
# Get yours at: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOLITE_LICENSE_KEY=

# HTTPS
IS_HTTPS_ENABLED=true    # Set to true if serving over HTTPS
